# Copy to .env and fill in. Loaded automatically at startup (process.loadEnvFile).

# --- Local model (preferred) ---
# Your MLX-LM server, OpenAI-compatible endpoint.
LOCAL_LLM_URL=http://192.168.0.145:8080/v1
# Must match a model the server has loaded (check: curl $LOCAL_LLM_URL/models).
LOCAL_MODEL=mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit-DWQ

# --- Cloud model (fallback, optional) ---
# Any OpenAI-spec endpoint. Leave OPENAI_API_KEY empty to disable cloud entirely.
CLOUD_LLM_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o
OPENAI_API_KEY=

# --- Tools ---
# Web search (Tavily). Leave empty to disable web_search.
TAVILY_API_KEY=

# Chrome control.
#   BROWSER_MODE: auto (default) = attach to CHROME_CDP_URL if up, else launch headless;
#                 cdp = only attach; headless = always launch our own headless Chrome.
BROWSER_MODE=auto
CHROME_CDP_URL=http://localhost:9222
# Only needed if headless launch can't auto-find Chrome:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Web search provider order. First to return results wins; rest are fallbacks.
# tavily-first is the default: public engines CAPTCHA headless browsers. The "browser"
# provider is meant for a scrapeable engine you control (e.g. self-hosted SearXNG).
WEB_SEARCH_ORDER=tavily,browser

# --- Google (read-only Gmail + Calendar) ---
# Credentials are auto-loaded from ~/.config/agentspine/client_secret_*.json. Only set
# these to override that. Scopes are read-only by construction (see src/config.ts).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_FILE=/absolute/path/to/client_secret.json
# Then run once:  npm run auth   (opens a consent screen YOU approve)

# --- Loop ---
# Heartbeat interval in minutes for `npm run loop`.
HEARTBEAT_MINUTES=30

# --- Active memory ---
# Standing facts injected on every run live in profile.md at the repo root. Point
# elsewhere if you keep it outside the repo.
# PROFILE_PATH=/absolute/path/to/profile.md
# Largest profile we will inject, in characters. It costs context on every step.
# PROFILE_MAX_CHARS=4000
# How many stored memories are auto-recalled before each run. 0 disables auto-recall
# (the memory_recall tool still works).
# MEMORY_RECALL_K=5
# After each run, one local-only pass extracts durable facts about you into memory.
# Set to false to turn it off entirely.
# REFLECT_ENABLED=true
# Most facts a single reflection may store.
# REFLECT_MAX_FACTS=3
# A candidate fact this cosine-similar to something stored is dropped as a duplicate.
# REFLECT_DEDUPE_THRESHOLD=0.9
# Ceiling on auto-learned memories; oldest reflections are pruned past it. Hand-saved
# notes are never pruned.
# REFLECT_MEMORY_MAX=500

# --- Conversations ---
# How many earlier turns of a chat are replayed into the next one. Smaller than it looks:
# each turn costs context on EVERY step of the loop, not once. What gets replayed is the
# compacted turn — what was asked, what was concluded — never the tool trace, which would
# exhaust a local model's context in about three turns.
# CHAT_HISTORY_TURNS=8
# Hard ceiling on that history in characters; oldest turns are dropped first. The turn cap
# alone isn't enough — one run that summarized a long document could otherwise crowd out
# the tools prompt on a small local model.
# CHAT_HISTORY_MAX_CHARS=6000
# Name each conversation from its opening exchange. Pinned to the local model by
# construction (a title is not worth sending your mail to a cloud model); if local is
# unreachable the thread simply keeps its fallback name.
# CHAT_AUTO_TITLE=true

# --- Senses ---
# Where the `weather` tool looks when the agent doesn't name a place. Keeping it here
# rather than in profile.md means it isn't restated in every run's context, and doesn't
# sit in a tool argument in the audit log on every call. Also enable it in policy.json:
#   "weather": { "enabled": true }
# DEFAULT_LOCATION=Asheville, NC

# --- weather_alerts thresholds (the "weather-alerts" watcher) ---
# Values shown are the built-in defaults; uncomment to override. Worth uncommenting the lot
# even if you keep the numbers — it puts what you get alerted about in one visible place
# instead of leaving it implicit in config.ts.
#
# IMPORTANT: these are calibrated for a New England climate. Recalibrate for yours — 92F is
# genuinely hot in New Hampshire and an unremarkable summer day in Texas. Getting this wrong
# in either direction is how the watcher becomes either noise or a false sense of quiet.
#
# Temperatures are "feels like", not dry-bulb: 92F at high humidity is what flattens you,
# and 25F in a gale is the cold one.
#
# Two tiers per class. The lower fires at notification priority 3; the upper is "severe" and
# breaks Do Not Disturb at priority 4. Only the higher tier is emitted when both match, so
# one hot day never produces two alerts.
# WEATHER_ALERT_HEAT_F=92
# WEATHER_ALERT_SEVERE_HEAT_F=100
# WEATHER_ALERT_COLD_F=10
# WEATHER_ALERT_SEVERE_COLD_F=-5

# A sharp day-over-day drop in the high. Catches the cold snap that trips neither absolute
# threshold: 58F falling to 28F is nobody's deep freeze and is still the night pipes freeze.
# WEATHER_ALERT_SWING_F=25

# Snow, in inches. The 2-day figure is the total across two CONSECUTIVE days, because a
# storm that starts at 6pm and ends at noon puts 4" in one calendar column and 4" in the
# next — one 8" event a per-day threshold alone would miss entirely.
# WEATHER_ALERT_SNOW_IN=6
# WEATHER_ALERT_SNOW_2DAY_IN=6
# WEATHER_ALERT_SEVERE_SNOW_IN=12

# Peak gusts, mph. These two ARE the NWS levels (wind advisory / high wind warning). The
# threshold is on gusts rather than sustained speed, since gusts take down the limb.
# WEATHER_ALERT_GUST_MPH=46
# WEATHER_ALERT_SEVERE_GUST_MPH=58

# Lookahead windows, in days, deliberately unequal. Temperature TRENDS are trustworthy well
# past a week, but skill for specific AMOUNTS — inches of snow, peak gust — falls off
# sharply after about day 3. Alerting on "6 inches Tuesday" from a week out reports model
# noise as news, which is how a watcher earns being muted.
# WEATHER_ALERT_TEMP_DAYS=5
# WEATHER_ALERT_STORM_DAYS=3
# Wind is a single-day event, forecast reliably only at short range.
# WEATHER_ALERT_WIND_DAYS=2
# Snow: 2 = you hear about a storm the day before. 3 = about two days' notice. Higher buys
# planning time at the cost of alerts for storms that later evaporate.
# WEATHER_ALERT_SNOW_DAYS=2

# When the agent asks for a priority 4-5 notification (one that overrides Do Not Disturb),
# second-guess it with a cloud-preferring judgment call first. Off by default: it costs a
# model round-trip per urgent notification. Worth turning on once it runs unattended
# enough that a bad interrupt actually costs you something.
# JUDGE_INTERRUPTIONS=false

# --- Push notifications (ntfy) ---
# Leave NTFY_TOPIC empty and notifications fall back to a Mac banner — fine on a laptop,
# useless on a headless Mini, which is why this exists.
# Works with the public server or your own; only the URL changes.
# NTFY_URL=https://ntfy.sh
# On the PUBLIC ntfy.sh the topic name is the ONLY secret — anyone who knows it can read
# your notifications, and your notifications quote your calendar and mail. Use a long
# random topic (`openssl rand -hex 12`), or self-host.
# NTFY_TOPIC=agentspine-<long-random-string>
# Bearer token for a protected or reserved topic. Optional.
# NTFY_TOKEN=

# The URL YOUR PHONE uses to reach the dashboard — a Tailscale name or LAN IP. Required
# for Approve/Reject buttons on a push; without it pushes still arrive, just without
# buttons. Never a port-forwarded public address (SPEC §3): use Tailscale or the LAN.
# DASHBOARD_PUBLIC_URL=http://mini.your-tailnet.ts.net:8787

# Automatic push triggers.
# NOTIFY_ON_CONFIRMATION=true   # an irreversible action is waiting on you (highest value)
# NOTIFY_ON_FAILURE=true        # a scheduled/heartbeat run errored — catches silent rot
# NOTIFY_ON_SCHEDULE=false      # every scheduled run reports in. Off by default: watchers
#                               # should be silent unless something changed, and a brief
#                               # that wants you can just call the `notify` tool itself.

# --- Dashboard (server.ts) ---
# DASHBOARD_PORT=8787
# Bind localhost-only by default. To reach it from other machines on the LAN, set
# DASHBOARD_HOST=0.0.0.0 — but you MUST also set DASHBOARD_TOKEN (the server refuses to
# expose the API to the network without one). Then open http://<this-mac-ip>:8787 and enter
# the token when prompted. Only do this on a trusted LAN.
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_TOKEN=change-me-to-a-long-random-string

# --- Model tiers ---
# A tier is a SEPARATE ALWAYS-WARM ENDPOINT, not another model name on the same server.
# mlx_lm.server holds one model resident, so switching models on one server costs 1.7-7.9s
# — measured — which is more than a smaller model saves. Two pinned servers never swap.
#
# On the model host:
#   mlx_lm.server --model mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit-DWQ --port 8080 --host 0.0.0.0
#   mlx_lm.server --model mlx-community/Llama-3.2-3B-Instruct-4bit           --port 8081 --host 0.0.0.0
#
# Leave FAST_LLM_URL empty and the fast tier resolves to standard — a safe no-op.
# FAST_LLM_URL=http://192.168.0.145:8081/v1
# FAST_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit

# Size each task before running it. Sizing only ever routes UP: `standard` is the floor, and
# `fast` is reached by an explicit override or an agent file declaring `tier: fast`, never by
# a pattern. The rule that sent short questions down to `fast` was removed after it handed
# "What is my name?" to a 3B — see the header of src/dispatch.ts for what that produced.
# Setting this false also disables cloud escalation, which is the half that measurably works.
# AUTO_ROUTE=true
# Let a cheap model second-guess whether a deliberative task ("should we…", "X versus Y")
# deserves the cloud tier. ~0.8s on those tasks only. This one buys answer quality, not
# speed — routing DOWN for speed measured as a net loss, routing UP for judgment does not.
# JUDGE_ESCALATION=true

# --- Subagents ---
# How deep delegation may nest. 1 lets a run delegate but stops a unit delegating onward.
# SUBAGENT_MAX_DEPTH=1
# Default step cap for a delegated unit; an agents/*.md file may lower it.
# SUBAGENT_MAX_STEPS=6

# --- Testing ---
# Point at scratch files so a test never writes into the ledger or policy you actually use.
# SPINE_DB_PATH=/tmp/scratch.db
# POLICY_PATH=/tmp/scratch-policy.json

# --- Ledger retention ---
# The ledger only ever grew before this: ~16KB per run, about 22MB a year at four scheduled
# jobs a day. The dashboard prunes on boot and daily; `npm run prune --dry` shows what would
# go. 0 on any of these means keep forever.
#
# Worth knowing the split before you tune it — conversation traces are ~61% of the bytes,
# the audit log ~36%, and the run rows themselves only ~3%. So RUN_RETENTION_DAYS=0 keeps
# your entire Activity history for almost no space while still discarding the bulky parts.
# RETENTION_DAYS=90
# TRACE_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=90
# RUN_RETENTION_DAYS=90

# Meeting transcripts get their own, shorter window. They are the most sensitive rows this
# system holds and the ones whose value decays fastest once a summary has been pulled out of
# them. This covers the raw words only — anything extracted into a project index or a memory
# is kept until you delete it.
# TRANSCRIPT_RETENTION_DAYS=30

# --- Meetings (live transcription) ---
# Requires whisper.cpp and ffmpeg:
#   brew install whisper-cpp ffmpeg
#   mkdir -p ~/.whisper-models && cd ~/.whisper-models
#   curl -LO https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
#   curl -LO https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
# Then allowlist a microphone in policy.json — `npm run listen devices` prints the snippet.
#
# Two models, two jobs. Measured on an M3 Pro: base.en does a 5-second chunk in 0.35s and
# drives the on-screen transcript; large-v3-turbo runs once at the end at 11x realtime (a
# 27-minute meeting took 2m28s) and produces the transcript everything else is built on.
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL_DIR=~/.whisper-models
# WHISPER_LIVE_MODEL=ggml-base.en.bin
# WHISPER_FINAL_MODEL=ggml-large-v3-turbo.bin

# Seconds of audio per live chunk. Whisper always processes a 30-second window internally, so
# below ~4s you pay nearly a full transcription for a fraction of the words; above ~8s the
# transcript visibly lags the room.
# MEETING_CHUNK_SECONDS=5

# Ceiling on one meeting. Audio is held in memory (~1.9 MB/minute), so this is also the
# memory ceiling. It mostly exists to bound a capture nobody stopped.
# MEETING_MAX_MINUTES=180
# MEETING_MIN_WORDS=50

# Names whisper reliably mishears, as wrong=right pairs, applied to the final transcript.
# Substitution rather than a decoder prompt because a prompt only biases: measured on a real
# recording, a glossary fixed "chat GPT" to "ChatGPT" and still transcribed "Claude" as
# "PLOD" in both passes.
# MEETING_CORRECTIONS=PLOD=Claude,Vardant=Guardant

# What a finished transcript is turned into: a summary, topics and decisions (saved
# automatically) plus candidate work items, which go to the confirmation queue instead.
# They go there because a single extraction pass over a real recording produced 5 false
# positives out of 5, every one stamped "high confidence" — extraction proposes, you dispose.
# Turning this off still captures, stores and indexes transcripts; only the pass is skipped.
# MEETING_EXTRACT_ENABLED=true

# Run extraction against a different local server than the agent loop uses. The default
# LOCAL_MODEL is a *Coder* fine-tune doing conversation analysis, which is the wrong tool at
# identical cost; plain Qwen3-30B-A3B-Instruct on a second port is the comparison worth
# running. Extraction is pinned to local whatever you set here.
# MEETING_EXTRACT_BASE_URL=http://192.168.0.145:8082/v1
# MEETING_EXTRACT_MODEL=mlx-community/Qwen3-30B-A3B-Instruct-4bit

# Words of transcript per extraction call. A transcript that overruns the context window
# loses its END — the part with the decisions in it — so long ones are windowed and merged.
# MEETING_EXTRACT_WINDOW_WORDS=3500

# Candidates put through the strict second pass, which costs ~2.3s each. Bounds a runaway
# extraction to about a minute; hitting the cap is recorded in the extraction's note.
# MEETING_EXTRACT_MAX_ITEMS=40

# Live context cards — the sidecar beside the running transcript. Retrieval ONLY: ~63ms to
# embed the rolling window plus ~101ms to score 50,000 chunks, so it runs continuously for
# nothing. Generation is 35 tok/s and belongs on a hotkey, not on a timer.
# MEETING_CARDS_ENABLED=true

# Seconds of transcript used as the query, and seconds between refreshes. The window is the
# recent past because the cards answer "what is being said NOW" — querying with the whole
# meeting drags every card toward whatever dominated the opening. The interval is the rate the
# panel changes at: per-segment would re-rank twelve times a minute and replace cards nobody
# had finished reading.
# MEETING_CARDS_WINDOW_SECONDS=60
# MEETING_CARDS_INTERVAL_SECONDS=15
# MEETING_CARDS_K=3

# Two filters decide whether a card appears at all, because one cannot do it.
#
# MIN_SCORE is the absolute floor. Measured against a real meeting corpus with
# nomic-embed-text: groceries/weather/football top out at 0.41-0.45, generic "we should
# refactor that module" reaches 0.55, genuinely on-topic runs 0.60-0.74. Hence 0.58. THIS
# NUMBER BELONGS TO THE EMBEDDING MODEL — a different one has a different floor.
#
# RELATIVE is the gap to the best hit, and catches what the floor cannot: inside a
# single-domain corpus everything scores high, and a passage about screenshots measured 0.618
# against a question about traceability while the right passage scored 0.708.
# A fact this similar to one already stored is refused. Enforced inside remember(), so every
# writer gets it — the memory_save tool, reflection, and the preference saved when you reject
# something with a reason. It used to live in reflect.ts alone, which is how the tool came to
# store 20 identical copies of one sentence: with MEMORY_RECALL_K at 5, all five recall slots
# came back holding the same fact. A duplicate does not sit quietly beside the original — it
# evicts something else. Falls back to REFLECT_DEDUPE_THRESHOLD if that is set.
# MEMORY_DEDUPE_THRESHOLD=0.9

# Ceiling on `note` memories, the ones memory_save writes. Reflections have had a cap since
# they were built; notes had none and grew without bound. 0 keeps them forever.
# NOTE_MEMORY_MAX=300

# MEETING_CARDS_MIN_SCORE=0.58
# MEETING_CARDS_RELATIVE=0.9

# The coaching hotkey: ⌘/ during a live meeting asks the local model for notes on what was
# just said. A deliberate keypress, never a timer — this one generates, and generation is
# 35 tok/s. Off leaves the sidecar retrieval-only, which is still useful on its own.
# MEETING_COACH_ENABLED=true

# Seconds treated as "what was just asked" — both the question and the retrieval query.
# Shorter than the sidecar's window because this has to pinpoint a question rather than
# characterise a topic.
# MEETING_COACH_WINDOW_SECONDS=45

# The transcript carried in the prompt's stable prefix, and the granularity it is trimmed at.
#
# The prompt is built backwards from every other prompt here — transcript first, retrieved
# context LAST — because MLX-LM reuses its KV cache for a byte-identical prefix. Measured at
# ~2,631 tokens with context varying per press: prefill 3.6s with context last, 9.2s with it
# first. The cap therefore has to be enforced in JUMPS: a sliding window would move the first
# byte every few seconds and throw the whole benefit away.
# MEETING_COACH_MAX_SEGMENTS=600
# MEETING_COACH_BLOCK=100

# --- Dictation: speak into the chat composer instead of typing ---------------------------
# Two microphones, because the dashboard is opened from more than one machine. The BROWSER
# records where you are sitting and uploads the blob; it needs a secure context, so it works
# on localhost and over HTTPS and is refused on a plain-http LAN address — a browser rule the
# server cannot grant. The SERVER mic reuses the meetings path and its policy.audio allowlist,
# works however you browse, and is refused while a meeting is recording.
# DICTATION_ENABLED=true

# The accurate model, not the fast one. Meetings run base.en live because a rough transcript
# that keeps up beats a good one that lags; dictation inverts every term of that — the
# utterance is seconds long, nothing waits on it, and the text becomes an instruction to an
# agent that can call tools. 14s of speech transcribes in ~1.4s.
# DICTATION_MODEL=ggml-large-v3-turbo.bin

# The decoder prompt, and it is not decoration. Measured on a 14-second clip, large-v3-turbo
# with no prompt returns "great um i by profession and choice uh i'm a tester i worked in the
# industry for i don't know how many long how many years" — lowercase, unpunctuated,
# disfluencies intact. With the prompt: "Great. I, by profession and choice, am a tester. I
# worked in the industry for, I don't know how many years". Whisper conditions its FORMATTING
# on preceding context and a dictation never has any, being short is what makes it a
# dictation. (Note this is the opposite of MEETING_CORRECTIONS, where a prompt was measured
# NOT to fix a misheard name: a prompt biases style well and vocabulary badly.)
# DICTATION_PROMPT=The following is a clearly punctuated transcript, with correct capitalisation and full stops.

# Ceilings. Seconds bounds the ffmpeg decode and releases the server microphone if a
# push-to-talk never gets its release; bytes stops a request body growing without limit.
# DICTATION_MAX_SECONDS=120
# DICTATION_MAX_BYTES=16777216
