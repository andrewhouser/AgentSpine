node_modules/
.env
spine.db
spine.db-*
# Your own standing facts — name, family, employer, how you like things done. Injected as
# trusted context on every run, and nobody else's business. Start from profile.example.md.
profile.md
# Audio you captured. A meeting recording is other people's voices, recorded in a room they
# were in; it does not belong in a repo whatever it was useful for.
test_recording/
*.m4a
*.wav
# Build output of the web client (source lives in web/). `npm run web:build` regenerates it.
public/
data/
audit/
# Approved drafts — unsent mail and event proposals, i.e. your correspondence.
drafts/
# Images you attached to a message. A photograph is of your garden, your desk, your
# paperwork — the same reasoning as the audio above, and it does not belong in a repo
# whatever it was useful for. Deleting a conversation deletes its images from here too.
attachments/
# Generated images from the generate_image tool. Machine-generated output served at
# /images/, regenerated on demand — not source, and potentially large.
images/
# Never commit credentials that were left in this directory.
client_secret_*.json
google-token.json
_archive/
# Internal design docs — not for the public repo.
MIGRATION.md

# Log files
.log

# OS files
.DS_Store

# IDE / editor settings
.claude/

# Xcode per-user state for the iPhone app (ios/). The project file is shared; which window
# you had open and where the cursor was is not.
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/build/
*.xcworkspace/xcuserdata/

# Signing material. The APNs .p8 belongs outside the repo entirely (ios/README.md step 2
# puts it in ~/.config/agentspine), and these rules exist for the day it lands here anyway:
# Apple issues it once and never again, it can push to every app in the team, and it does
# not expire — so a single careless `git add` is a credential published forever, recoverable
# only by revoking the key. Belt and braces, deliberately.
*.p8
*.p12
*.cer
*.mobileprovision

# EventKit helper binary (built by update.sh / on first use)
services/eventkit/.build/
backups/
# Files the assistant saves for you (write_file's default folder)
docs/*
!docs/PLAN-*.md

# Python venv for the speaker-diarization helper (services/diarize).
services/diarize/.venv/
