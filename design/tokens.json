{
  "version": 1,
  "name": "spine",
  "alpha": {
    "dark": { "line": 0.3, "soft": 0.14 },
    "light": { "line": 0.28, "soft": 0.11 }
  },
  "themes": {
    "light": {
      "accent": "#2563a8",
      "attention": "#8a5a0b",
      "bg": "#f6f8fa",
      "bg-elevated": "#ffffff",
      "bg-inset": "#edf0f4",
      "bg-sidebar": "#eef1f5",
      "border": "#dde2e9",
      "border-strong": "#bfc7d2",
      "danger": "#b3342b",
      "ok": "#15774a",
      "on-accent": "#ffffff",
      "spine": "#c4ccd7",
      "text": "#12171e",
      "text-dim": "#4b5563",
      "text-faint": "#5f6775",
      "warn": "#8a5a0b"
    },
    "dark": {
      "accent": "#86b6ea",
      "attention": "#f0b35a",
      "bg": "#0f1318",
      "bg-elevated": "#171c23",
      "bg-inset": "#141920",
      "bg-sidebar": "#0b0e12",
      "border": "#262d36",
      "border-strong": "#3a4552",
      "danger": "#f07a72",
      "ok": "#6fcf9b",
      "on-accent": "#0b1a2b",
      "spine": "#2a323d",
      "text": "#e9e7e0",
      "text-dim": "#a0a9b4",
      "text-faint": "#7f8995",
      "warn": "#f0b35a"
    }
  },
  "derived": {
    "comment": "Each name below gets a -line and a -soft tint of the base colour, at the alpha above.",
    "tints": ["accent", "danger", "ok", "warn", "attention"]
  },
  "web": {
    "scrim": { "light": "rgb(15 20 32 / 38%)", "dark": "rgb(0 0 0 / 55%)" },
    "shadow": {
      "light": "0 1px 2px rgb(16 24 40 / 6%), 0 4px 12px rgb(16 24 40 / 5%)",
      "dark": "0 1px 2px rgb(0 0 0 / 35%), 0 4px 14px rgb(0 0 0 / 25%)"
    }
  },
  "fonts": {
    "display": "\"Bricolage Grotesque\", ui-sans-serif, -apple-system, \"Segoe UI\", system-ui, sans-serif",
    "sans": "\"Instrument Sans\", ui-sans-serif, -apple-system, \"Segoe UI\", system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", menlo, monospace"
  },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 18 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "type": {
    "comment": "Point sizes. Web uses rem (size / 16), native uses Dynamic Type styles scaled from these.",
    "caption": 12,
    "footnote": 13,
    "body": 15,
    "title3": 17,
    "title2": 22,
    "title1": 30,
    "display": 34
  },
  "verdict": {
    "comment": "Which colour token the broker's verdict maps to. Verdict colours are never the accent.",
    "executed": "ok",
    "denied": "danger",
    "queued": "warn",
    "dryRun": "accent",
    "error": "danger"
  }
}
