{
  "name": "agentspine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first, mostly-automated agentic loop with a reversibility-tiered capability broker.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "tick": "node src/spine.ts once",
    "loop": "node src/spine.ts loop",
    "confirm": "node src/confirm.ts",
    "auth": "node src/google/auth.ts",
    "do": "node src/do.ts",
    "dashboard": "node src/server.ts",
    "watcher": "node src/watcher.ts",
    "digest": "node src/digest.ts",
    "test": "node test/weather-alerts.test.mjs && node test/dispatch.test.mjs && node test/narrow-policy.test.mjs && node test/subagent-budget.test.mjs && node test/ingest.test.mjs",
    "browser:check": "node src/browser-check.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"web/**/*.css\"",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm test"
  },
  "dependencies": {
    "openai": "^4.104.0",
    "playwright-core": "^1.48.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "markdown-it": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
